# Overrides for infra/autumn/docker-compose.autumn.yml (Option D — shared deps)
# Canonical ports: infra/ports.md

# Postgres: same credentials as infra/db/postgres; database name must be `autumn`.
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:4003/autumn
REDIS_URL=redis://host.docker.internal:4004

AUTUMN_API_PORT=4002
AUTUMN_VITE_PORT=4001

# --- LEGACY: infra/autumn/docker-compose.yml (dedicated Postgres on host 4003) ---
