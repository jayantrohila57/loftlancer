# Server-side env for apps/auth — copy to `.env` (gitignored).
# Client/public values belong in `.env.local` (see `.env.local.example`).

NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:4003/loftlancer_auth
# Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# AES-256-GCM for @packages/crypto/server (optional until modules need it)
# Generate: openssl rand -hex 32
# ENCRYPTION_KEY=
BETTER_AUTH_URL=http://localhost:3002/auth

# OAuth (optional until providers are configured)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GitHub OAuth App → Authorization callback URL (exact):
# http://localhost:3002/auth/api/auth/callback/github

# Email (production magic link)
# RESEND_API_KEY=
# RESEND_FROM=Loftlancer <no-reply@example.com>  # Use a verified Resend domain.

# Autumn billing — self-hosted OSS (infra/autumn/README.md), not api.useautumn.com
# Required for upgrades, invoices, payment methods, and billing portal (overview works from DB without it).
AUTUMN_API_BASE_URL=http://localhost:4002
# AUTUMN_X_API_VERSION=2.3.0      # match self-hosted OSS max (see infra/autumn README); SDK default 2.6.0 fails on older server
# AUTUMN_SECRET_KEY=am_sk_...   # copy from local dashboard http://localhost:4001 → API keys (or AUTUMN_VITE_PORT)
# AUTUMN_WEBHOOK_SECRET=...     # webhook signing secret from self-hosted Autumn dashboard
# AUTUMN_PLAN_ID_FREE=free      # optional override if dashboard plan ids differ
# AUTUMN_PLAN_ID_PAID=paid

# Allowed application destinations after sign-in
STUDIO_APP_URL=http://localhost:3003
CONSOLE_APP_URL=http://localhost:3004

# Device authorization (RFC 8628) — comma-separated allowlist; empty rejects all clients
# BETTER_AUTH_DEVICE_CLIENT_IDS=loftlancer-cli
# BETTER_AUTH_DEVICE_SCOPES=openid profile
# BETTER_AUTH_DEVICE_VERIFICATION_URL=http://localhost:3002/auth/device
# Bootstrap platform admin role for verified emails (comma-separated). Empty denies everyone.
CONSOLE_ADMIN_EMAILS=

# Account help & support — mailto target (batch E2)
# SUPPORT_EMAIL=support@example.com

# Sentry (optional — unset disables instrumentation)
# NEXT_PUBLIC_SENTRY_DSN=https://…@…ingest…sentry.io/…
# SENTRY_DSN=          # server-only DSN when public var is not available
# SENTRY_ORG=          # build / source-map upload (Vercel)
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_TEST_TOKEN=   # 32+ chars for optional test-error routes

# OAuth / MCP (optional — administrator-managed clients only; no public registration)
# MCP_RESOURCE_URL=http://localhost:3002/auth/api/mcp
# OAUTH_TRUSTED_CLIENT_IDS=first-party-cli,studio-mcp
# MCP_RATE_LIMIT_WINDOW_MS=60000
# MCP_RATE_LIMIT_MAX_REQUESTS=120
# MCP_RATE_LIMIT_MAX_WRITE=30
# MCP_RATE_LIMIT_MAX_REVEAL=10

# OpenTelemetry (optional — see @packages/observability and docs/packages/package-and-api.md)
# OBSERVABILITY_TRACING_PROVIDER=none
# OBSERVABILITY_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=auth
