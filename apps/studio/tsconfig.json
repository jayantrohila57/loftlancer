{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@modules/*": ["../../module/*"],
      "@module/*": ["../../module/*"],
      "@features/authentication/*": ["../../features/authentication/src/*"],
      "@features/authorization/*": ["../../features/authorization/src/*"],
      "@features/notifications/*": ["../../features/notifications/src/*"],
      "@features/api/*": ["../../features/api/src/*"],
      "@features/analytics/*": ["../../features/analytics/src/*"],
      "@features/observability/*": ["../../features/observability/src/*"],
      "@features/shell/*": ["../../features/shell/src/*"],
      "@features/marketing/*": ["../../features/marketing/src/*"],
      "@features/patterns/*": ["../../features/patterns/src/*"],
      "@features/data-table/*": ["../../features/data-table/src/*"],
      "@features/*": ["../../features/*"],
      "@packages/drizzle": ["../../packages/drizzle/src/index.ts"],
      "@packages/drizzle/*": ["../../packages/drizzle/src/*"],
      "@packages/orpc": ["../../packages/orpc/src/index.ts"],
      "@packages/orpc/*": ["../../packages/orpc/src/*"],
      "@packages/better-auth": ["../../packages/better-auth/src/index.ts"],
      "@packages/better-auth/*": ["../../packages/better-auth/src/*"],
      "@packages/typescript-config": ["../../packages/typescript-config"],
      "@packages/typescript-config/*": ["../../packages/typescript-config/*"],
      "@packages/crypto": ["../../packages/crypto/src/index.ts"],
      "@packages/crypto/*": ["../../packages/crypto/src/*"],
      "@packages/resend": ["../../packages/resend/src/index.ts"],
      "@packages/resend/*": ["../../packages/resend/src/*"],
      "@packages/t3-env": ["../../packages/t3-env/src"],
      "@packages/t3-env/*": ["../../packages/t3-env/src/*"],
      "@packages/sentry": ["../../packages/sentry/src/index.ts"],
      "@packages/sentry/*": ["../../packages/sentry/src/*"],
      "@packages/mcp": ["../../packages/mcp/src/index.ts"],
      "@packages/ui": ["../../packages/ui/src"],
      "@packages/ui/*": ["../../packages/ui/src/*"]
    }
  },
  "include": [
    "./next-env.d.ts",
    "./**/*.ts",
    "./**/*.tsx",
    "./.next/types/**/*.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["./node_modules", "./e2e"]
}
