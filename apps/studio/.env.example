# Server-side env for apps/studio — copy to `.env` (gitignored).

NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3003
DATABASE_URL=postgresql://postgres:postgres@localhost:4003/loftlancer_auth

# Use the same auth URL, database and secret as the Auth app.
BETTER_AUTH_URL=http://localhost:3002/auth
BETTER_AUTH_SECRET=

# Optional product analytics (CDN loader; requires account analytics consent in Auth).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry (optional) — see apps/auth/.env.example
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# SENTRY_TEST_TOKEN=   # 32+ chars for optional test-error routes

# OpenTelemetry (optional — see @packages/observability and docs/packages/package-and-api.md)
# OBSERVABILITY_TRACING_PROVIDER=none
# OBSERVABILITY_TRACING_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=studio
