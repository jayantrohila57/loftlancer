# Public URL of the Auth app, including its base path.
NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3002/auth

# Public URL of this Studio app (optional; falls back to `/studio` on same origin).
# NEXT_PUBLIC_STUDIO_APP_URL=http://localhost:3003

# Sentry browser DSN (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# Product analytics (optional — gated on account analytics consent in Auth)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
