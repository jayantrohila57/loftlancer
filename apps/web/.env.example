# Server-side env for apps/web — copy to `.env` (gitignored).

NODE_ENV=development
APP_PUBLIC_URL=http://localhost:3001
DATABASE_URL=postgresql://postgres:postgres@localhost:4003/loftlancer_auth

# Optional marketing analytics (stays off until a consent banner exists).
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# OpenTelemetry (optional — unset = no OTLP export)
# OBSERVABILITY_TRACING_PROVIDER=otel
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=web

# Sentry (optional) — browser DSN in `.env.local` when used
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# SENTRY_TEST_TOKEN=   # 32+ chars for optional test-error routes
