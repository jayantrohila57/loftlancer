# Client-side env for apps/web — copy to `.env.local` (gitignored).

# Auth app base URL (required for header session + sign-in links)
NEXT_PUBLIC_AUTH_APP_URL=http://localhost:3002/auth
NEXT_PUBLIC_STUDIO_APP_URL=http://localhost:3003

# Sentry browser DSN (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# Optional marketing analytics (stays off until a consent banner exists — see docs/apps/web-dev.md)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Public RSS feed URL (footer RSS button; today uses APP_PUBLIC_URL + /feed.xml from the server)
# NEXT_PUBLIC_SITE_RSS_URL=