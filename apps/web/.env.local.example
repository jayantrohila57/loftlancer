# Client-side env for apps/web — copy to `.env.local` (gitignored).

# Sentry browser DSN (optional)
# NEXT_PUBLIC_SENTRY_DSN=

# Optional marketing analytics (stays off until a consent banner exists — see docs/apps/web-dev.md)
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com