{
  "$schema": "https://v2-11-11.turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "SKIP_ENV_VALIDATION",
    "NODE_ENV",
    "DATABASE_URL",
    "AUTH_SECURITY_TEST_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "BETTER_AUTH_DEVICE_CLIENT_IDS",
    "APP_PUBLIC_URL",
    "WEB_APP_URL",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "GITHUB_CLIENT_ID",
    "GITHUB_CLIENT_SECRET",
    "ENCRYPTION_KEY",
    "RESEND_API_KEY",
    "NEXT_PUBLIC_AUTH_APP_URL",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_APP_VERSION",
    "SENTRY_DSN",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN",
    "SENTRY_TEST_TOKEN",
    "OBSERVABILITY_TRACING_PROVIDER",
    "OBSERVABILITY_TRACING_ENABLED",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_TRACES_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "OTEL_SERVICE_NAME",
    "NEXT_PUBLIC_POSTHOG_KEY",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID",
    "POSTHOG_PROJECT_ID",
    "POSTHOG_PERSONAL_API_KEY",
    "REDIS_URL",
    "KV_REST_API_URL",
    "KV_REST_API_READ_ONLY_TOKEN",
    "KV_URL",
    "KV_REST_API_TOKEN",
    "UPSTASH_REDIS_REST_URL",
    "UPSTASH_REDIS_REST_TOKEN",
    "CRON_SECRET",
    "AUTUMN_SECRET_KEY",
    "AUTUMN_WEBHOOK_SECRET",
    "AUTUMN_PLAN_ID_FREE",
    "AUTUMN_PLAN_ID_PAID",
    "AUTUMN_API_BASE_URL",
    "AI_GATEWAY_API_KEY",
    "AI_GATEWAY_BASE_URL",
    "BLOB_READ_WRITE_TOKEN",
    "BLOB_STORE_ID",
    "RESEND_FROM",
    "BETTER_STACK_SOURCE_TOKEN",
    "CONSOLE_ADMIN_EMAILS",
    "CONSOLE_APP_URL",
    "STUDIO_APP_URL",
    "MCP_RESOURCE_URL",
    "MCP_RATE_LIMIT_WINDOW_MS",
    "MCP_RATE_LIMIT_MAX_REQUESTS",
    "MCP_RATE_LIMIT_MAX_WRITE",
    "MCP_RATE_LIMIT_MAX_REVEAL",
    "VERCEL_SERVICES",
    "NEXT_BASE_PATH",
    "RELEASE_REPO_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
