{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": ["SKIP_ENV_VALIDATION"],
  "globalDependencies": ["package.json", "CHANGELOG.md"],
  "globalEnv": [
    "ORGANIZATIONS_ENABLED",
    "NEXT_PUBLIC_ORGANIZATIONS_ENABLED",
    "NOTIFICATIONS_ENABLED",
    "NEXT_PUBLIC_NOTIFICATIONS_ENABLED",
    "VARIABLES_V2_ENABLED",
    "NEXT_PUBLIC_VARIABLES_V2_ENABLED",
    "ACTIONS_AUDIT_ENABLED",
    "NEXT_PUBLIC_ACTIONS_AUDIT_ENABLED",
    "SOFT_DELETES_ENABLED",
    "NEXT_PUBLIC_AUTH_URL",
    "NEXT_PUBLIC_STUDIO_URL",
    "NEXT_PUBLIC_ACCOUNT_URL",
    "VERCEL_SERVICES",
    "PLATFORM_PUBLIC_ORIGIN",
    "NEXT_PUBLIC_PLATFORM_ORIGIN",
    "NEXT_BASE_PATH",
    "NEXT_PUBLIC_DOCS_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "GITHUB_CLIENT_ID",
        "GITHUB_CLIENT_SECRET",
        "CORS_ORIGIN",
        "SKIP_ENV_VALIDATION",
        "ENCRYPTION_KEY",
        "ORGANIZATIONS_ENABLED",
        "NEXT_PUBLIC_ORGANIZATIONS_ENABLED",
        "NOTIFICATIONS_ENABLED",
        "NEXT_PUBLIC_NOTIFICATIONS_ENABLED",
        "VARIABLES_V2_ENABLED",
        "NEXT_PUBLIC_VARIABLES_V2_ENABLED",
        "ACTIONS_AUDIT_ENABLED",
        "NEXT_PUBLIC_ACTIONS_AUDIT_ENABLED",
        "SOFT_DELETES_ENABLED",
        "E2E_TEST_MODE",
        "E2E_TEST_SECRET",
        "NEXT_PUBLIC_AUTH_URL",
        "NEXT_PUBLIC_STUDIO_URL",
        "NEXT_PUBLIC_ACCOUNT_URL",
        "VERCEL_SERVICES",
        "PLATFORM_PUBLIC_ORIGIN",
        "NEXT_PUBLIC_PLATFORM_ORIGIN",
        "NEXT_BASE_PATH",
        "NEXT_PUBLIC_DOCS_URL",
        "NODE_OPTIONS",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "SENTRY_ORG",
        "SENTRY_PROJECT",
        "SENTRY_AUTH_TOKEN",
        "NEXT_PUBLIC_VERCEL_ENV",
        "VERCEL_ENV",
        "NEXT_PUBLIC_GA_MEASUREMENT_ID",
        "NEXT_PUBLIC_POSTHOG_KEY",
        "NEXT_PUBLIC_POSTHOG_HOST",
        "GOOGLE_SITE_VERIFICATION",
        "BING_SITE_VERIFICATION",
        "VERCEL_GIT_COMMIT_SHA",
        "CI",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "CRON_SECRET",
        "KV_URL",
        "KV_REST_API_URL",
        "KV_REST_API_TOKEN",
        "KV_REST_API_READ_ONLY_TOKEN",
        "REDIS_URL",
        "BLOB_READ_WRITE_TOKEN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "BETTERSTACK_API_TOKEN",
        "SENTRY_TEST_TOKEN"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["^test"],
      "env": [
        "SKIP_ENV_VALIDATION",
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "TEST_DATABASE_URL",
        "RUN_DB_INTEGRATION_TESTS"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "db:push": {
      "cache": false
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:migrate": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:check-schema": {
      "cache": false
    },
    "db:reset-seed": {
      "cache": false,
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_POOLED",
        "RESET_CONFIRM",
        "KEEP_USER_EMAIL",
        "SKIP_ENV_VALIDATION",
        "ENCRYPTION_KEY",
        "BETTER_AUTH_SECRET",
        "BETTER_AUTH_URL",
        "CORS_ORIGIN"
      ]
    }
  }
}
