{
  "name": "@loftlancer/auth",
  "type": "module",
  "exports": {
    ".": {
      "default": "./src/index.ts"
    },
    "./session-types": {
      "default": "./src/session-types.ts"
    },
    "./return-to": {
      "default": "./src/return-to.ts"
    },
    "./platform-auth": {
      "default": "./src/create-platform-auth.ts"
    },
    "./sibling-auth": {
      "default": "./src/create-sibling-auth.ts"
    },
    "./platform-middleware": {
      "default": "./src/platform-middleware.ts"
    },
    "./guards": {
      "default": "./src/guards/index.ts"
    },
    "./*": {
      "default": "./src/*.ts"
    },
    "./passwordless": {
      "default": "./src/passwordless.ts"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test src/return-to.test.ts src/guards/session-access.test.ts src/session-cookies.test.ts src/platform-middleware.test.ts src/e2e-route-access.test.ts src/member-removal-policy.test.ts src/organization-member-removal.test.ts src/rate-limit-storage.test.ts"
  },
  "dependencies": {
    "@better-auth/cimd": "^1.7.7",
    "@better-auth/mcp": "^1.7.7",
    "@loftlancer/actions": "workspace:*",
    "@loftlancer/db": "workspace:*",
    "@loftlancer/email": "workspace:*",
    "@loftlancer/env": "workspace:*",
    "@loftlancer/logger": "workspace:*",
    "@loftlancer/notifications": "workspace:*",
    "@loftlancer/ui": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@loftlancer/config": "workspace:*",
    "next": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
