{
  "extends": "@loftlancer/typescript-config/tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "jsx": "react-jsx",
    "paths": {
      "@modules/*": ["../../module/*"],
      "@module/*": ["../../module/*"],
      "@features/api/*": ["../../features/api/src/*"],
      "@features/authentication/*": ["../../features/authentication/src/*"],
      "@features/authorization/*": ["../../features/authorization/src/*"],
      "@features/notifications/*": ["../../features/notifications/src/*"],
      "@features/analytics/*": ["../../features/analytics/src/*"],
      "@features/observability/*": ["../../features/observability/src/*"],
      "@features/shell/*": ["../../features/shell/src/*"],
      "@features/marketing/*": ["../../features/marketing/src/*"],
      "@features/patterns/*": ["../../features/patterns/src/*"],
      "@features/data-table/*": ["../../features/data-table/src/*"],
      "@features/*": ["../../features/*"],
      "@packages/drizzle": ["../drizzle/src/index.ts"],
      "@packages/drizzle/*": ["../drizzle/src/*"],
      "@packages/orpc": ["../orpc/src/index.ts"],
      "@packages/orpc/*": ["../orpc/src/*"],
      "@packages/better-auth": ["../better-auth/src/index.ts"],
      "@packages/better-auth/*": ["../better-auth/src/*"],
      "@packages/typescript-config": ["../typescript-config"],
      "@packages/typescript-config/*": ["../typescript-config/*"],
      "@packages/crypto": ["../crypto/src/index.ts"],
      "@packages/crypto/*": ["../crypto/src/*"],
      "@packages/resend": ["../resend/src/index.ts"],
      "@packages/resend/*": ["../resend/src/*"],
      "@packages/t3-env": ["../t3-env/src"],
      "@packages/t3-env/*": ["../t3-env/src/*"],
      "@packages/sentry": ["../sentry/src/index.ts"],
      "@packages/sentry/*": ["../sentry/src/*"],
      "@packages/mcp": ["../mcp/src/index.ts"],
      "@packages/ui": ["../ui/src"],
      "@packages/ui/*": ["../ui/src/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
