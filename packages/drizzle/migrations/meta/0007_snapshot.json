      "checkConstraints": {
        "activity_event_identity_check": {
          "name": "activity_event_identity_check",
          "value": "length(\"activity_event\".\"activity_id\") BETWEEN 1 AND 256 AND length(\"activity_event\".\"action_id\") BETWEEN 1 AND 160 AND length(\"activity_event\".\"category\") BETWEEN 1 AND 80 AND \"activity_event\".\"schema_version\" > 0"
        },
        "activity_event_actor_check": {
          "name": "activity_event_actor_check",
          "value": "\"activity_event\".\"actor_type\" IN ('user', 'system', 'integration', 'unknown') AND (\"activity_event\".\"actor_user_id\" IS NULL OR \"activity_event\".\"actor_type\" = 'user')"
        },
        "activity_event_outcome_check": {
          "name": "activity_event_outcome_check",
          "value": "\"activity_event\".\"outcome\" IN ('success', 'denied', 'failed', 'error', 'unknown')"
        },
        "activity_event_values_check": {
          "name": "activity_event_values_check",
          "value": "(\"activity_event\".\"before_value\" IS NULL OR (jsonb_typeof(\"activity_event\".\"before_value\") = 'object' AND octet_length(\"activity_event\".\"before_value\"::text) <= 65536)) AND (\"activity_event\".\"after_value\" IS NULL OR (jsonb_typeof(\"activity_event\".\"after_value\") = 'object' AND octet_length(\"activity_event\".\"after_value\"::text) <= 65536)) AND (\"activity_event\".\"metadata\" IS NULL OR (jsonb_typeof(\"activity_event\".\"metadata\") = 'object' AND octet_length(\"activity_event\".\"metadata\"::text) <= 65536))"
        },
        "activity_event_target_check": {
          "name": "activity_event_target_check",
          "value": "\"activity_event\".\"target\" IS NULL OR (jsonb_typeof(\"activity_event\".\"target\") = 'object' AND \"activity_event\".\"target\" ? 'routeKey' AND jsonb_typeof(\"activity_event\".\"target\"->'routeKey') = 'string' AND length(\"activity_event\".\"target\"->>'routeKey') BETWEEN 1 AND 160 AND octet_length(\"activity_event\".\"target\"::text) <= 4096)"
        }
      },
