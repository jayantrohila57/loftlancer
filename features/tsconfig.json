{
  "extends": "@loftlancer/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@features/*": ["./*"]
    }
  },
  "include": ["shared/**/*.ts", "**/shared/**/*.ts"],
  "exclude": ["./node_modules"]
}
