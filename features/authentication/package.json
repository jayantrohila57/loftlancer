  },
  "dependencies": {
    "@loftlancer/features-authorization": "workspace:*",
    "@loftlancer/features-notifications": "workspace:*",
    "@loftlancer/better-auth": "workspace:*",
    "@loftlancer/drizzle": "workspace:*",
    "@loftlancer/resend": "workspace:*",
    "@loftlancer/t3-env": "workspace:*",
    "@loftlancer/ui": "workspace:*",
    "drizzle-orm": "catalog:",
    "lucide-react": "^1.56.0",
    "next": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@loftlancer/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
