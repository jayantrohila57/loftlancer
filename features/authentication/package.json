{
  "name": "@loftlancer/features-authentication",
  "description": "Session and Better Auth product UX.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./utils": "./src/utils/index.ts",
    "./utils/*": "./src/utils/*",
    "./types/*": "./src/types/*",
    "./constants/*": "./src/constants/*",
    "./config/*": "./src/config/*",
    "./core/server": "./src/core/server/index.ts",
    "./core/server/*": "./src/core/server/*",
    "./core/client": "./src/core/client/index.ts",
    "./core/client/*": "./src/core/client/*"
  },
