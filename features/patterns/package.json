{
  "name": "@loftlancer/features-patterns",
  "description": "Reusable UI patterns on the design system.",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./core/client": "./src/core/client/index.ts",
    "./core/client/*": "./src/core/client/*",
    "./utils/*": "./src/utils/*",
    "./config/*": "./src/config/*"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@loftlancer/features-authorization": "workspace:*",
    "@loftlancer/features-shell": "workspace:*",
    "@loftlancer/ui": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.56.0",
    "next": "catalog:",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@loftlancer/typescript-config": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
