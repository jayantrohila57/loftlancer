{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/studio/api/cron/purge-apps",
      "schedule": "30 21 * * *"
    },
    {
      "path": "/studio/api/cron/cleanup-file-uploads",
      "schedule": "45 21 * * *"
    }
  ],
  "regions": ["sin1"],
  "trailingSlash": false,
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "services": {
    "docs": {
      "root": "apps/docs",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 pnpm turbo run build --filter=docs",
      "headers": [
        {
          "source": "/favicon/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "/favicon.ico",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "/sentry-test",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "private, no-store"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        },
        {
          "source": "/api/health",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store, max-age=0"
            },
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "X-Robots-Tag",
              "value": "noindex, nofollow"
            }
          ]
        }
      ]
    },
    "www": {
      "root": "apps/www",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 pnpm turbo run build --filter=www",
      "headers": [
        {
          "source": "/favicon/(.*)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "/favicon.ico",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        }
      ]
    },
    "auth": {
      "root": "apps/auth",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 NEXT_BASE_PATH=/better-auth pnpm turbo run build --filter=auth"
    },
    "studio": {
      "root": "apps/studio",
      "framework": "nextjs",
      "installCommand": "cd ../.. && pnpm install",
      "buildCommand": "cd ../.. && VERCEL_SERVICES=1 NEXT_BASE_PATH=/studio pnpm turbo run build --filter=studio"
    }
  },
  "redirects": [
    {
      "source": "/auth",
      "destination": "/better-auth",
      "permanent": true
    },
    {
      "source": "/auth/:path*",
      "destination": "/better-auth/:path*",
      "permanent": true
    },
    {
      "source": "/better-auth/api/better-auth/:path*",
      "destination": "/better-auth/api/auth/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/better-auth",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/better-auth/:path*",
      "destination": {
        "service": "auth"
      }
    },
    {
      "source": "/studio",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/studio/:path*",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/docs-static/:path*",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/docs/:path*",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/health",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/api/mcp",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/sentry-test",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "docs"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "www"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "www"
      }
    }
  ]
}
