{
  "extends": "@loftlancer/config/tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@module/*": ["./*"]
    }
  },
  "include": [
    "shared/**/*.ts",
    "teams/utils/**/*.ts",
    "teams/server/controller/**/*.ts",
    "teams/server/service/**/*.ts"
  ],
  "exclude": ["./node_modules"]
}
