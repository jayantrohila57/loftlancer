{
  "extends": "@packages/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@modules/whats-new": ["./src/index.ts"],
      "@modules/whats-new/*": ["./src/*"],
      "next-intl": ["../../apps/web/node_modules/next-intl"],
      "react": ["../../apps/web/node_modules/@types/react"],
      "react/jsx-runtime": [
        "../../apps/web/node_modules/@types/react/jsx-runtime"
      ]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
