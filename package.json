{
  "name": "loftlancer-template",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build --concurrency=1",
    "dev": "turbo dev",
    "dev:apps": "turbo dev --filter=web --filter=studio --filter=console",
    "infra-up": "bash scripts/infra/up.sh",
    "infra-up:build": "LOFTLANCER_INFRA_BUILD=1 bash scripts/infra/up.sh",
    "infra-down": "bash scripts/infra/down.sh",
    "infra-status": "bash scripts/infra/status.sh",
    "lint": "node scripts/i18n/cleanup-probes.mjs && biome check . && pnpm check:i18n",
    "fix": "node scripts/i18n/cleanup-probes.mjs && biome check --write .",
    "fix:unsafe": "biome check --write --unsafe .",
    "format": "biome format --write .",
    "check": "pnpm format && pnpm lint && pnpm typecheck",
    "typecheck": "turbo typecheck",
    "check:i18n": "node scripts/i18n/check.mjs",
    "check:ci": "pnpm exec biome ci . && pnpm check:i18n && pnpm typecheck",
    "prepare": "husky",
    "check:commit": "pnpm check:ci && pnpm build",
    "version-check": "node -p \"require('./package.json').version\"",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:check": "node scripts/release/check.mjs origin/main",
    "release:notes": "node scripts/release/notes.mjs",
    "release:publish": "bash scripts/release/publish.sh"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@packages/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next-intl": "^4.14.9",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "typescript-programmatic": "npm:typescript@5.9.3"
  },
  "packageManager": "pnpm@12.20.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
