{
  "name": "loftlancer",
  "version": "1.26.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' turbo build --concurrency=2",
    "check-types": "turbo check-types",
    "test": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://localhost:5432/test turbo test && pnpm --filter studio exec node --import tsx --test ../../scripts/pwa-manifest.test.ts && pnpm test:teams",
    "dev:docs": "turbo -F docs dev",
    "dev:www": "turbo -F www dev",
    "dev:auth": "turbo -F auth dev",
    "dev:studio": "turbo -F studio dev",
    "db:push": "turbo -F @loftlancer/drizzle db:push",
    "db:studio": "turbo -F @loftlancer/drizzle db:studio",
    "db:generate": "turbo -F @loftlancer/drizzle db:generate",
    "db:migrate": "turbo -F @loftlancer/drizzle db:migrate",
    "db:reset-seed": "turbo -F @loftlancer/drizzle db:reset-seed",
    "db:check-schema": "turbo -F @loftlancer/drizzle db:check-schema",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check-routes": "bash scripts/check-route-literals.sh",
    "audit:module-architecture": "node scripts/audit-module-architecture.mjs",
    "audit:architecture-layers": "node scripts/audit-architecture-layers.mjs",
    "verify:dev-merge": "pnpm lint:ci && pnpm check-routes && pnpm audit:module-architecture && pnpm audit:architecture-layers && pnpm check-types && pnpm test",
    "audit:api-entrypoints": "node scripts/generate-api-entrypoint-inventory.mjs",
    "fix": "biome check --write --unsafe .",
    "prepare": "husky",
    "version-check": "node -p \"require('./package.json').version\"",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:check": "node scripts/release/check.mjs origin/main",
    "release:notes": "node scripts/release/notes.mjs",
    "release:publish": "bash scripts/release/publish.sh",
    "generate:pwa-maskable-icons": "pnpm --filter studio exec tsx ../../scripts/generate-pwa-maskable-icons.mts",
    "capture:pwa-screenshots": "pnpm --filter studio exec tsx ../../scripts/capture-pwa-screenshots.mts",
    "test:teams": "SKIP_ENV_VALIDATION=1 pnpm --filter @loftlancer/orpc exec node --experimental-test-module-mocks --import tsx --test ../../module/shared/server/run-action.test.ts ../../module/shared/utils/validation/utils.service-response.validation.test.ts ../../module/teams/server/controller/server.team-create.controller.test.ts",
    "test:teams:integration": "SKIP_ENV_VALIDATION=1 ORGANIZATIONS_ENABLED=true SOFT_DELETES_ENABLED=true pnpm --filter @loftlancer/orpc exec node --experimental-test-module-mocks --import tsx --test ../../module/teams/server/service/server.teams.integration.test.ts ../../module/teams/server/service/server.teams-migration.integration.test.ts",
    "test:organizations:integration": "SKIP_ENV_VALIDATION=1 ORGANIZATIONS_ENABLED=true SOFT_DELETES_ENABLED=true pnpm --filter @loftlancer/orpc exec node --experimental-test-module-mocks --import tsx --test ../../module/organizations/server/service/server.organizations-migration.integration.test.ts"
  },
  "dependencies": {
    "@loftlancer/t3-env": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@loftlancer/typescript-config": "workspace:*",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=12.11.2"
  }
}
