{
  "name": "loftlancer",
  "version": "1.19.10",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "NODE_OPTIONS='--max-old-space-size=6144' turbo build --concurrency=2",
    "check-types": "turbo check-types",
    "test": "SKIP_ENV_VALIDATION=1 DATABASE_URL=postgresql://localhost:5432/test turbo test && pnpm --filter studio exec node --import tsx --test ../../scripts/pwa-manifest.test.ts",
    "dev:docs": "turbo -F docs dev",
    "dev:www": "turbo -F www dev",
    "dev:auth": "turbo -F auth dev",
    "dev:studio": "turbo -F studio dev",
    "db:push": "turbo -F @loftlancer/db db:push",
    "db:studio": "turbo -F @loftlancer/db db:studio",
    "db:generate": "turbo -F @loftlancer/db db:generate",
    "db:migrate": "turbo -F @loftlancer/db db:migrate",
    "db:reset-seed": "turbo -F @loftlancer/db db:reset-seed",
    "db:check-schema": "turbo -F @loftlancer/db db:check-schema",
    "check": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:ci": "biome ci --error-on-warnings .",
    "check-routes": "bash scripts/check-route-literals.sh",
    "fix": "biome check --write --unsafe .",
    "prepare": "husky",
    "version-check": "node -p \"require('./package.json').version\"",
    "release:prepare": "node scripts/release/prepare.mjs",
    "release:check": "node scripts/release/check.mjs origin/main",
    "release:notes": "node scripts/release/notes.mjs",
    "release:publish": "bash scripts/release/publish.sh",
    "generate:pwa-maskable-icons": "pnpm --filter studio exec tsx ../../scripts/generate-pwa-maskable-icons.mts",
    "capture:pwa-screenshots": "pnpm --filter studio exec tsx ../../scripts/capture-pwa-screenshots.mts"
  },
  "dependencies": {
    "@loftlancer/env": "workspace:*",
    "@opentelemetry/api": "^1.9.1",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@loftlancer/config": "workspace:*",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "^2.11.7",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": [
      "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.14.0",
    "pnpm": ">=12.11.2"
  }
}
